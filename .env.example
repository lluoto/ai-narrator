# AI Narrator Server Configuration

# ── LLM API ──
# API key (required — one of these)
LLM_API_KEY=sk-your-key-here
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# API base URL
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama:   http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name
# OpenAI:   gpt-4o-mini, gpt-4o
# DeepSeek: deepseek-chat
# Ollama:   llama3, qwen2.5
LLM_MODEL=gpt-4o-mini

# Generation settings
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ── Server ──
# PORT is a decimal integer from 1 through 65535 (default: 3099).
PORT=3099
# Only the exact values development and test enable development-only switches.
NODE_ENV=development

# Compiler control-plane authentication (both are required and must differ)
# Generate two independent random printable tokens of at least 32 characters.
# Keep these commented until real secrets are supplied: compiler/catalog routes
# fail closed with 503 when either token is absent or malformed.
# COMPILER_OPERATOR_BEARER_TOKEN=<operator-secret>
# COMPILER_KEEPER_BEARER_TOKEN=<keeper-secret>

# Ordinary-session owner authentication is required by default. Only the exact
# development_anonymous value with NODE_ENV exactly development or test enables
# the temporary legacy compatibility mode. Every other or missing NODE_ENV is
# fail-closed; never use this mode in production. A shared environment bearer
# identifies one service account, not an individual-user IdP principal.
ORDINARY_SESSION_AUTH_MODE=required

# Ordinary HTTP actions require the server-owned intent API by default. Only
# the exact development_fallback value with NODE_ENV exactly development or
# test permits the legacy regex compatibility path; request bodies cannot
# choose this policy.
ORDINARY_SESSION_INTENT_POLICY=required

# Optional single-P1 browser invitation delivery. When this explicit deployment
# secret is absent or invalid, compiled sessions remain owner-only.
# Generate at least 32 random bytes and base64url-encode them (43+ URL-safe
# characters); do not reuse an operator/Keeper bearer token or commit a value.
# COMPILER_PLAYER_DELIVERY_HMAC_SECRET=<43-or-more-base64url-characters>
# Digest-only claim acknowledgements survive restarts under this private root.
# COMPILER_PLAYER_DELIVERY_ROOT=./data/compiled-player-delivery
# Both TTLs are whole seconds from 60 through 31536000.
# COMPILER_PLAYER_DELIVERY_INVITE_TTL_SECONDS=900
# COMPILER_PLAYER_DELIVERY_COOKIE_TTL_SECONDS=604800
# Required exact HTTPS browser origin when browser player delivery is enabled.
# Use only an origin (for example https://play.example); missing/invalid values
# disable player delivery. Do not rely on X-Forwarded-* headers.
# COMPILER_PUBLIC_ORIGIN=https://play.example

# Optional read-only reviewed-source research facade. Set all five values as an
# atomic, hash-pinned binding or leave all commented: incomplete configuration
# returns 503. Use delegated_assistant for the current delegated-review v2
# candidate manifest; use human only for a separately pinned human-reviewed
# artifact. Add lead_model only when its separately hash-pinned reviewed rows
# must be admitted (for example, human,lead_model). This endpoint accepts GET
# only and never grants runtime authority.
# SOURCE_RESEARCH_MANIFEST_PATH=<absolute-path-to-reviewed-v2-manifest>
# SOURCE_RESEARCH_MANIFEST_SHA256=<64-lowercase-hex-sha256-of-manifest-bytes>
# SOURCE_RESEARCH_RECORDS_PATH=<absolute-path-to-matched-source-records>
# SOURCE_RESEARCH_RECORDS_SHA256=<64-lowercase-hex-sha256-of-records-bytes>
# SOURCE_RESEARCH_ALLOWED_REVIEWER_CLASSES=delegated_assistant
# For a distinct lead-model-reviewed artifact only:
# SOURCE_RESEARCH_ALLOWED_REVIEWER_CLASSES=human,lead_model

# Optional read-only reviewed-slot research endpoint. It is default-off: set
# all five values as one atomic, hash-pinned binding or leave all commented.
# Missing or partial configuration returns 503. Restart the server after any
# binding change because the environment is captured during handler startup.
# The separately pinned index must map every real manifest artifact hash to an
# absolute read-only path and the same full-file SHA-256. This GET-only endpoint
# returns frozen metadata receipts and has no runtime authority.
# SLOT_RESEARCH_MANIFEST_PATH=<absolute-path-to-reviewed-slot-manifest>
# SLOT_RESEARCH_MANIFEST_SHA256=<64-lowercase-hex-sha256-of-manifest-bytes>
# SLOT_RESEARCH_ARTIFACT_BINDING_INDEX_PATH=<absolute-path-to-artifact-binding-index-json>
# SLOT_RESEARCH_ARTIFACT_BINDING_INDEX_SHA256=<64-lowercase-hex-sha256-of-index-bytes>
# SLOT_RESEARCH_ALLOWED_REVIEWER_CLASSES=lead_model

# ── Session ──
# Positive decimal safe-integer minutes of inactivity before auto-cleanup
# (default: 30). The minute-to-millisecond conversion must also be safe.
SESSION_TIMEOUT_MINUTES=30

# Process-local ordinary owner WebSocket admission. All values are strict
# positive decimal safe integers; per-session/principal values may not exceed
# the global value. Defaults: 512 / 4 / 32.
ORDINARY_SESSION_WEBSOCKET_MAX_CONNECTIONS=512
ORDINARY_SESSION_WEBSOCKET_MAX_CONNECTIONS_PER_SESSION=4
ORDINARY_SESSION_WEBSOCKET_MAX_CONNECTIONS_PER_PRINCIPAL=32

# Durable ordinary-session creation admission. All values are strict positive
# decimal safe integers. Defaults: global 2, per-principal 1, starts 4 per
# 60-second window. Per-principal concurrency cannot exceed the global limit.
ORDINARY_SESSION_CREATE_MAX_CONCURRENT=2
ORDINARY_SESSION_CREATE_MAX_CONCURRENT_PER_PRINCIPAL=1
ORDINARY_SESSION_CREATE_STARTS_PER_PRINCIPAL=4
ORDINARY_SESSION_CREATE_WINDOW_SECONDS=60

# ── 仓库外资源路径 ──
# 这几份在仓库之外，不同机器上的位置不一样：世界模型 229MB（v18 + 克苏鲁子模型）
# 与前端构建产物都不进 git。缺失时服务不会崩，只会静默降级（world-model-loader.ts
# 找不到文件时 log.warn 后跳过，KP 上下文注入/幻觉风险评分/规则映射失效；
# 前端目录缺失时回落到内置测试页）。加载是懒的：世界模型在第一次建会话时才读，
# 服务启动本身不受影响。详见 docs/deploy.md「二、干净克隆构建与可选的运行期世界模型」。
#
# 下面是相对路径示例（相对进程 CWD，即仓库根目录的上一级）；容器部署时通常改成
# 镜像内绝对路径（如 /app/assets/...），见 docs/deploy.md 的环境变量对照表。
# 未设置时用代码里的内置默认值，不是这里写的示例值。
# WORLD_MODEL_PATH=../世界模型/v18_output/v18_all_master.jsonl
# CTHULHU_MODEL_PATH=../世界模型/datasets/cthulhu/extracted/cthulhu_world_model.jsonl
# Optional compiled Cthulhu publication binding authority. These are an atomic
# pair: leave both unset to disable it. When enabled, the policy is a checked
# JSON file and the dataset is its separately mounted read-only dataset root;
# never let a request choose either path, work scope, or transfer policy.
# COMPILED_CTHULHU_WORLD_MODEL_POLICY_PATH=/absolute/read-only/compiled-cthulhu-policy.json
# CTHULHU_DATASET_PATH=/absolute/read-only/cthulhu-dataset-root
# Docker's optional docker-compose.world-model.yml override uses these host-only
# variables for read-only bind mounts. They are not passed to the application.
# WORLD_MODEL_ASSETS_DIR=/absolute/legacy-assets-directory
# COMPILED_CTHULHU_WORLD_MODEL_POLICY_HOST_PATH=/absolute/reviewed-policy.json
# CTHULHU_DATASET_HOST_PATH=/absolute/cthulhu-dataset-root
# FRONTEND_DIR=../frontend/dist

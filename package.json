{
  "name": "ai-narrator",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "run": "bun src/index.ts",
    "server": "bun src/api/server.ts",
    "dev-server:start": "powershell -File scripts/dev-server.ps1 start",
    "dev-server:stop": "powershell -File scripts/dev-server.ps1 stop",
    "dev-server:status": "powershell -File scripts/dev-server.ps1 status"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
